{
  "redirects": [
    {
      "source": "/register",
      "destination": "https://app.hkpc.no",
      "permanent": true
    },
    {
      "source": "/bible-resources",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/opptak",
      "destination": "/admission",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/personvern",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/om",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/om-oss",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/skole",
      "destination": "/#school",
      "permanent": true
    },
    {
      "source": "/kurs",
      "destination": "/#school",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=43200"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
